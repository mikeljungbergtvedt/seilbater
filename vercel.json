{
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/boats/index.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/boats/[url].js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/cron.js": {
      "maxDuration": 300,
      "memory": 1024
    }
  }
}
